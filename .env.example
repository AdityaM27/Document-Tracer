# DocuTrace Environment Configuration Template
# Copy this file to .env and configure local values

# C++ Server Configuration
DOCUTRACE_SERVER_HOST=0.0.0.0
DOCUTRACE_SERVER_PORT=8080
DOCUTRACE_WORKER_THREADS=4

# Python AI Microservice Configuration
DOCUTRACE_AI_HOST=127.0.0.1
DOCUTRACE_AI_PORT=8000
DOCUTRACE_AI_MODEL=roberta-base-openai-detector

# External Academic API Configuration (Polite Pool headers)
OPENALEX_POLITE_EMAIL=docutrace-lab@university.edu
CROSSREF_USER_AGENT=DocuTrace-Academic/1.0 (mailto:docutrace-lab@university.edu)

# General Web Search Provider (Optional)
WEB_SEARCH_API_KEY=your_search_api_key_here
WEB_SEARCH_ENDPOINT=https://api.searchprovider.com/v1
